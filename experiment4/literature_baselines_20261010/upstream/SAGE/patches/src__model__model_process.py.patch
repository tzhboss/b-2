+def _save_observed_query_ranks(args, batches, phase):
+    # Observation only: capture native integer ranks before float/round conversion.
+    from pathlib import Path
+    export_dir = Path(args.rank_export_dir)
+    export_dir.mkdir(parents=True, exist_ok=True)
+    export_file = export_dir / f"train{args.snapshot}_test{args.snapshot_test}_{phase}.npz"
+    if export_file.exists():
+        raise FileExistsError(str(export_file))
+    rows = np.concatenate(batches, axis=0)
+    np.savez_compressed(export_file, head=rows[:, 0], relation=rows[:, 1],
+                        tail=rows[:, 2], rank=rows[:, 3],
+                        candidates=rows[:, 4], filtered_count=rows[:, 5],
+                        trained_snapshot=np.int64(args.snapshot),
+                        tested_snapshot=np.int64(args.snapshot_test),
+                        seed=np.int64(args.seed), phase=np.array(phase),
+                        metric_contract=np.array('author double-argsort; historical query-snapshot candidates/filter'))
